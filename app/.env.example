# Optional deployment Google Maps API key used for the Routes and Places HTTP
# APIs. You can also paste a custom key in the app; it overrides this value.
# See README.md for how to create one and which APIs to enable.
# NOTE: in Expo Go this key must NOT use HTTP-referrer or app restrictions
# (mobile requests send no referrer) — restrict it to the Routes API +
# Places API (New) instead.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here
